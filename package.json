{
  "name": "playerhaat-server",
  "version": "0.1.0",
  "private": true,
  "description": "PlayerHaat REST API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:seed:demo": "tsx prisma/seed/index.ts --demo",
    "db:reset": "prisma migrate reset --force",
    "admin:grant": "tsx src/scripts/grant-admin.ts",
    "docs:errors": "tsx scripts/gen-error-docs.ts",
    "loadtest:seed": "tsx scripts/loadtest/seed-bulk.ts",
    "loadtest:explain": "tsx scripts/loadtest/explain.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jose": "^6.2.13",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "6.19.3",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
