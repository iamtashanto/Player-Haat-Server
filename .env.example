# ───────────── Core ─────────────
NODE_ENV=development               # development | test | production
PORT=4000
LOG_LEVEL=info                     # fatal | error | warn | info | debug | trace | silent
# Comma-separated list of allowed browser origins (Next.js site, admin). Mobile apps don't send Origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001   # release: add the admin dashboard origin
# Background jobs (rating reminders). On by default; set false to run them on only one instance.
JOBS_ENABLED=true
# Load tests only: turn rate limiting off. The server refuses to start with this false in production.
RATE_LIMIT_ENABLED=true
# Set to 1 when running behind Nginx so req.ip / rate limits use X-Forwarded-For.
TRUST_PROXY=0

# ───────────── Database ─────────────
# docker compose maps Postgres to host port 5442.
DATABASE_URL=postgresql://playerhaat:playerhaat@localhost:5442/playerhaat?schema=public&connection_limit=5

# ───────────── Auth (used from phase 2) ─────────────
# 32+ random chars: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_IDS=                 # comma-separated Android/iOS/web OAuth client IDs
APPLE_CLIENT_IDS=                  # comma-separated: iOS bundle id and/or Services ID

# ───────────── Cloudinary (phase 3) ─────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ───────────── SMTP / Nodemailer ─────────────
# Leave SMTP_HOST empty in development: emails are not sent, the full message (with the 6-digit code) is logged instead.
# To see real emails locally run Mailpit (https://mailpit.axllent.org) and set SMTP_HOST=localhost, SMTP_PORT=1025.
# REQUIRED in production.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PlayerHaat <no-reply@playerhaat.local>"

# ───────────── Phone-OTP sign-in (SMS) ─────────────
PHONE_AUTH_ENABLED=true
# Generic HTTP gateway, GET: {to} = 8801XXXXXXXXX, {text} = URL-encoded message. 2xx = delivered.
# Leave empty in development: the code is logged instead of texted. Without it in production the
# phone endpoints answer 503.   e.g. https://gateway.example/api?key=SECRET&to={to}&msg={text}
SMS_HTTP_URL_TEMPLATE=
# Hard ceiling on OTP texts per rolling 24h across all users (cost cap against SMS-pumping fraud).
SMS_DAILY_LIMIT=2000

# ───────────── Firebase Admin / FCM (phase 4) ─────────────
# Either a path to the service-account JSON or the JSON itself (single line). Leave empty to disable push.
FIREBASE_SERVICE_ACCOUNT=

# ───────────── Misc ─────────────
# Public base URL of this API (used in Swagger "servers" and email links).
PUBLIC_API_URL=http://localhost:4000          # release: https://playerhaat-api.tashanto.com

# ───────────── Credit top-ups by mobile banking ─────────────
# The number customers send money to for each method. Leave empty to hide that method.
PAYMENT_BKASH_NUMBER=
PAYMENT_NAGAD_NUMBER=
PAYMENT_ROCKET_NUMBER=
