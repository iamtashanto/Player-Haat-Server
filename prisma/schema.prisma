// PlayerHaat — Prisma schema (PostgreSQL)
//
// Conventions
//  - ids are cuid() strings for entities we create, Int for static reference data we seed
//  - money is whole BDT (Int); all timestamps are UTC (timestamptz)
//  - phone numbers are stored in E.164 (+8801XXXXXXXXX)
//  - "…Code" columns on reference tables (Sport, Position, locations) are stable machine keys

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Locale {
  bn
  en
}

enum UserRole {
  PLAYER // mobile app: owns player profile(s), applies to requests
  RECRUITER // mobile app: discovers and evaluates players, posts requests
  ADMIN // web dashboard only; never created through public registration
}

/// Who may see a player's phone number from their profile.
enum ContactVisibility {
  ON_TAP // anyone signed in can tap "show number" (the default)
  AFTER_ACCEPT // only people the player has accepted (an accepted application or invite)
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum RequestKind {
  MATCH // "players needed for a game": players apply
  EVENT // a recruiter's trial / camp: players tap "interested"
}

enum VerificationKind {
  RECRUITER
  PLAYER_STATS
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CreditReason {
  PURCHASE
  CONTACT_REVEAL
  BOOST
  ADMIN_GRANT
  REFUND
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
}

enum PaymentStatus {
  PENDING // checkout created, user hasn't paid / submitted a transaction id yet
  SUBMITTED // user paid by mobile banking and sent the transaction id; waiting for an admin
  PAID
  REJECTED
}

enum RecruiterType {
  CLUB
  ACADEMY
  SCOUT
  AGENT
  ORGANIZER
  OTHER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthProvider {
  EMAIL
  PHONE // reserved: phone-OTP login is not planned for v1 but kept so adding it needs no migration
  GOOGLE
  APPLE
}

enum VerificationType {
  EMAIL_VERIFY
  PASSWORD_RESET
  PHONE_OTP
}

enum VideoSource {
  YOUTUBE
  UPLOAD // reserved for our own hosting (a paid feature later); the API answers UPLOAD_NOT_AVAILABLE for now
}

enum MediaType {
  PHOTO
  VIDEO_LINK
}

enum TravelRadius {
  UNION
  UPAZILA
  DISTRICT
}

enum PreferredFoot {
  LEFT
  RIGHT
  BOTH
}

enum BattingStyle {
  RIGHT_HAND
  LEFT_HAND
}

enum TeamMemberRole {
  CAPTAIN
  VICE_CAPTAIN
  PLAYER
}

enum JoinMode {
  APPROVAL // players apply, the organiser accepts (default)
  OPEN_JOIN // players join straight away until the game is full
}

enum Attendance {
  ATTENDED
  NO_SHOW
}

enum RequestStatus {
  OPEN
  FILLED
  CANCELLED
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  WAITLISTED // applied to a full match; promoted automatically when a spot opens
}

enum RatingDirection {
  CAPTAIN_TO_PLAYER
  PLAYER_TO_CAPTAIN
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationType {
  NEW_MATCHING_REQUEST
  NEW_APPLICANT
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  REQUEST_CANCELLED
  REQUEST_UPDATED
  APPLICATION_WITHDRAWN
  RATING_REMINDER
  INVITE_RECEIVED
  INVITE_ACCEPTED
  INVITE_DECLINED
  CONTACT_VIEWED
  NEW_MESSAGE
  VERIFICATION_RESULT
  TEAM_JOINED
  SYSTEM
  NEARBY_AVAILABLE // someone near you is free to play today
  GAME_REMINDER // 2 hours before, and the morning of
  REQUEST_FILLED // the game you applied to is now full
  GAME_MESSAGE // a message in a game's group chat
  ANNOUNCEMENT // from the admin dashboard
  PROFILE_VIEWED // a recruiter opened your profile (once per recruiter per day)
  WAITLIST_PROMOTED // a spot opened in a full game you were waiting for
  SERIES_GAME_POSTED // this week's game of a series you are a regular in is up
  RESULT_POSTED // the organiser recorded the score of a game you played
}

enum PushStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum ReportTargetType {
  USER
  PLAYER_PROFILE
  REQUEST
  TEAM
  RATING
  CONVERSATION
}

enum AdminActionType {
  USER_SUSPEND
  USER_UNSUSPEND
  PROFILE_HIDE
  PROFILE_UNHIDE
  PROFILE_VERIFY
  PROFILE_UNVERIFY
  SPORT_PROFILE_HIDE
  SPORT_PROFILE_UNHIDE
  RECRUITER_VERIFY
  RECRUITER_UNVERIFY
  USER_ROLE_CHANGE
  VERIFICATION_APPROVE
  VERIFICATION_REJECT
  PAYMENT_APPROVE
  PAYMENT_REJECT
  CREDITS_GRANT
  CREDIT_PACK_SET
  CONVERSATION_VIEW
  REQUEST_HIDE
  REQUEST_UNHIDE
  REPORT_RESOLVE
  REPORT_DISMISS
  CONFIG_SET
  MEDIA_REMOVE
  VERIFICATION_FILE_VIEW
  RATING_HIDE
  RATING_UNHIDE
  RATING_DISPUTE_UPHOLD
  RATING_DISPUTE_REMOVE
  RATING_REPLY_REMOVE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  name            String
  email           String?    @unique // lower-cased; Apple private-relay addresses allowed
  emailVerifiedAt DateTime?
  phone           String?    @unique // E.164
  phoneVerifiedAt DateTime?
  passwordHash    String? // null for users who only use social login
  avatarUrl       String?
  avatarPublicId  String? // Cloudinary public id, needed to delete the old avatar
  locale          Locale     @default(bn)
  role            UserRole   @default(PLAYER)
  status          UserStatus @default(ACTIVE)
  birthYear       Int?
  deletedAt       DateTime?

  // Captain-side reputation (players rate captains too). Player-side lives on PlayerProfile.
  captainAvgRating   Float @default(0)
  captainRatingCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authAccounts             AuthAccount[]
  refreshTokens            RefreshToken[]
  verificationCodes        VerificationCode[]
  playerProfile            PlayerProfile?
  recruiterProfile         RecruiterProfile?
  creditBalance            Int                     @default(0) // maintained with the ledger, never negative (CHECK in the migration)
  // Admin two-factor sign-in (TOTP). The secret is stored encrypted; backup codes only as hashes.
  totpSecret               String?
  totpEnabledAt            DateTime?
  totpLastStep             Int? // the last 30-second step accepted, so one code can't be replayed
  totpBackupHashes         String[]                @default([])
  creditTransactions       CreditTransaction[]
  payments                 Payment[]
  contactReveals           ContactReveal[]         @relation("ContactViewer")
  invitesSent              Invite[]                @relation("InviteRecruiter")
  shortlist                ShortlistEntry[]
  verificationRequests     VerificationRequest[]   @relation("VerificationSubmitter")
  verificationsReviewed    VerificationRequest[]   @relation("VerificationReviewer")
  conversationsAsRecruiter Conversation[]          @relation("ConversationRecruiter")
  conversationsAsPlayer    Conversation[]          @relation("ConversationPlayer")
  messagesSent             Message[]
  gameMessages             GameMessage[]           @relation("GameMessageSender")
  notificationPreference   NotificationPreference?
  pushJobs                 PushJob[]
  webPushSubscriptions     WebPushSubscription[]
  verificationFiles        VerificationFile[]      @relation("VerificationFileOwner")
  profileViewsMade         ProfileView[]           @relation("ProfileViewer")
  teamsCaptained           Team[]                  @relation("TeamCaptain")
  teamMemberships          TeamMember[]
  requestsCreated          PlayerRequest[]
  applications             Application[]
  ratingsGiven             Rating[]                @relation("RatingRater")
  ratingsReceived          Rating[]                @relation("RatingRatee")
  deviceTokens             DeviceToken[]
  notifications            Notification[]
  reportsFiled             Report[]                @relation("ReportReporter")
  reportsResolved          Report[]                @relation("ReportResolver")
  adminActions             AdminAction[]
  gameSeries               GameSeries[]
  seriesMemberships        SeriesMember[]

  @@index([status])
  @@index([role, status])
}

model AuthAccount {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  // EMAIL: the lower-cased email · GOOGLE: `sub` · APPLE: `sub` · PHONE: E.164 number
  providerUserId String
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique // sha256 of the opaque token; the raw token is never stored
  // All tokens descended from one login share a family. Reuse of a rotated token revokes the family.
  familyId     String
  deviceId     String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique
  createdAt    DateTime  @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId, deviceId])
  @@index([familyId])
  @@index([expiresAt])
}

model VerificationCode {
  id         String           @id @default(cuid())
  userId     String?
  type       VerificationType
  target     String // email address or E.164 phone
  codeHash   String
  attempts   Int              @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, target, createdAt])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Locations — Division → District → Upazila → Union (seeded, read-only at runtime)
// ─────────────────────────────────────────────────────────────────────────────

model Division {
  id     Int     @id @default(autoincrement())
  code   String? @unique // BBS geocode when known (filled by the full dataset)
  nameBn String
  nameEn String
  slug   String  @unique

  districts District[]
}

model District {
  id         Int     @id @default(autoincrement())
  code       String? @unique // BBS geocode when known (filled by the full dataset)
  divisionId Int
  nameBn     String
  nameEn     String
  slug       String
  lat        Float?
  lng        Float?

  division   Division           @relation(fields: [divisionId], references: [id])
  upazilas   Upazila[]
  profiles   PlayerProfile[]
  requests   PlayerRequest[]
  teams      Team[]
  recruiters RecruiterProfile[]
  gameSeries GameSeries[]

  @@unique([divisionId, slug])
  @@index([nameEn])
}

model Upazila {
  id         Int     @id @default(autoincrement())
  code       String? @unique // BBS geocode when known (filled by the full dataset)
  districtId Int
  nameBn     String
  nameEn     String
  slug       String
  lat        Float?
  lng        Float?

  district   District        @relation(fields: [districtId], references: [id])
  unions     Union[]
  profiles   PlayerProfile[]
  requests   PlayerRequest[]
  teams      Team[]
  gameSeries GameSeries[]

  @@unique([districtId, slug])
  @@index([nameEn])
}

model Union {
  id        Int     @id @default(autoincrement())
  code      String? @unique // BBS geocode when known (filled by the full dataset)
  upazilaId Int
  nameBn    String
  nameEn    String
  slug      String

  upazila    Upazila         @relation(fields: [upazilaId], references: [id])
  profiles   PlayerProfile[]
  requests   PlayerRequest[]
  teams      Team[]
  gameSeries GameSeries[]

  @@unique([upazilaId, slug])
  @@index([nameEn])
}

// ─────────────────────────────────────────────────────────────────────────────
// Sports catalogue
// ─────────────────────────────────────────────────────────────────────────────

model Sport {
  id       Int     @id @default(autoincrement())
  code     String  @unique // FOOTBALL, CRICKET — a string (not enum) so adding BADMINTON is just a seed row
  nameBn   String
  nameEn   String
  isActive Boolean @default(true)

  positions    Position[]
  playerSports PlayerSport[]
  availability PlayerAvailability[]
  profileViews ProfileView[]
  teams        Team[]
  requests     PlayerRequest[]
  gameSeries   GameSeries[]
}

model Position {
  id      Int    @id @default(autoincrement())
  sportId Int
  code    String // GK, CB, … / BATTER, BOWLER, …
  nameBn  String
  nameEn  String
  order   Int    @default(0)

  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([sportId, code])
}

// ─────────────────────────────────────────────────────────────────────────────
// Players
// ─────────────────────────────────────────────────────────────────────────────

model PlayerProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  bio               String?
  // Home location. District + upazila are required so every profile is searchable by area.
  districtId        Int
  upazilaId         Int
  unionId           Int?
  isVisible         Boolean           @default(true) // player's own switch; admin hiding sets this false too
  verifiedBadge     Boolean           @default(false)
  // Set by an admin; unlike isVisible (the player's own switch) the player cannot clear it.
  hiddenByAdminAt   DateTime?
  contactVisibility ContactVisibility @default(ON_TAP)
  // Wide banner behind the avatar (about 3:1). The URL is derived from the stored path at read time.
  coverUrl          String?
  coverPublicId     String?

  avgRating    Float    @default(0) // raw mean of revealed reviews
  ratingCount  Int      @default(0) // revealed reviews
  bayesRating  Float    @default(3.5) // damped mean used only for ordering/featuring
  noShowCount  Int      @default(0)
  lastActiveAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  district       District             @relation(fields: [districtId], references: [id])
  upazila        Upazila              @relation(fields: [upazilaId], references: [id])
  union          Union?               @relation(fields: [unionId], references: [id])
  sports         PlayerSport[]
  media          PlayerMedia[]
  contactReveals ContactReveal[]
  invites        Invite[]
  shortlisted    ShortlistEntry[]
  availability   PlayerAvailability[]
  profileViews   ProfileView[]

  // Player search: filter by place, then walk the sort order — each index ends in `id`, the unique
  // tie-breaker the keyset cursor uses, so Postgres never has to sort. (Without the location-first
  // ones it walked the NATIONAL rating index and threw away 43k rows to fill a page for one upazila.)
  @@index([upazilaId, avgRating(sort: Desc), ratingCount(sort: Desc), id])
  @@index([districtId, avgRating(sort: Desc), ratingCount(sort: Desc), id])
  @@index([upazilaId, lastActiveAt(sort: Desc), id])
  @@index([districtId, lastActiveAt(sort: Desc), id])
  @@index([avgRating(sort: Desc), ratingCount(sort: Desc), id])
  @@index([bayesRating(sort: Desc), ratingCount(sort: Desc), id], map: "PlayerProfile_bayesRating_ratingCount_id_idx")
  @@index([lastActiveAt(sort: Desc), id])
  @@index([unionId])
}

/// "Available to play today" per sport. Rows expire by time (endsAt) and are swept by a job; readers
/// always filter on endsAt, so a late sweep never shows a stale player.
model PlayerAvailability {
  id        String   @id @default(cuid())
  profileId String
  sportId   Int
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  profile PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sport   Sport         @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([profileId, sportId])
  @@index([sportId, endsAt])
  @@index([endsAt])
}

model PlayerSport {
  id            String         @id @default(cuid())
  profileId     String
  sportId       Int
  positions     String[] // Position.code values; validated against the Position table in the service layer
  preferredFoot PreferredFoot? // football
  battingStyle  BattingStyle? // cricket
  skillLevel    Int // 1–5 self-declared (range enforced by Zod; CHECK constraint added in the migration)
  khepAvailable Boolean        @default(false) // available for paid one-off matches ("khep")
  rateMin       Int? // BDT per match
  rateMax       Int?
  // e.g. { "mon": ["morning","evening"], "fri": ["afternoon"] } — shape validated by Zod
  availability  Json?
  travelRadius  TravelRadius   @default(UPAZILA)

  // ── what makes this a sport profile in its own right ──
  headline        String? // one-line pitch for this sport, e.g. "Left-footed winger, 6 seasons in Dhaka leagues"
  experienceYears Int? // 0–60 (CHECK constraint in the migration)
  currentTeam     String?
  // Self-declared numbers; the shape is validated per sport (see sport-stats.ts).
  stats           Json?
  // The player's own switch for this one sport profile; the account-level isVisible still applies on top.
  isVisible       Boolean   @default(true)
  // Set by an admin; the player cannot clear it.
  hiddenByAdminAt DateTime?
  // Earned in matches of this sport only (the account-level rating on PlayerProfile blends all sports).
  avgRating       Float     @default(0)
  ratingCount     Int       @default(0)
  // Set when an admin approves a stats verification; editing the stats clears it.
  statsVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       PlayerProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sport         Sport                 @relation(fields: [sportId], references: [id])
  achievements  PlayerAchievement[]
  verifications VerificationRequest[]

  @@unique([profileId, sportId])
  @@index([sportId, khepAvailable])
  @@index([sportId, skillLevel])
  @@index([positions], type: Gin)
}

model PlayerAchievement {
  id            String   @id @default(cuid())
  playerSportId String
  title         String // "District league top scorer"
  year          Int?
  description   String?
  createdAt     DateTime @default(now())

  playerSport PlayerSport @relation(fields: [playerSportId], references: [id], onDelete: Cascade)

  @@index([playerSportId, year(sort: Desc)])
}

model PlayerMedia {
  id        String       @id @default(cuid())
  profileId String
  type      MediaType
  url       String
  publicId  String? // storage path / provider id (PHOTO only)
  order     Int          @default(0)
  caption   String?
  // Videos: where it is hosted, the id there, and which sports profile it belongs to (max 6 each).
  source    VideoSource?
  videoId   String?
  sportId   Int?
  createdAt DateTime     @default(now())

  profile PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, order])
  @@index([profileId, type, sportId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Recruiters
// ─────────────────────────────────────────────────────────────────────────────

model RecruiterProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  type          RecruiterType
  organization  String? // club / academy / company name; null for independent scouts
  bio           String?
  districtId    Int
  // Sport.id values this recruiter scouts for (validated against active sports in the service layer).
  sportIds      Int[]
  // Set by an admin after checking who they are; players can see it on the recruiter's public card.
  verifiedBadge Boolean       @default(false)
  // Club / academy / organisation logo, shown on the recruiter card and on their requests.
  logoUrl       String?
  logoPublicId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  district      District              @relation(fields: [districtId], references: [id])
  verifications VerificationRequest[]

  @@index([districtId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Teams
// ─────────────────────────────────────────────────────────────────────────────

model Team {
  id           String   @id @default(cuid())
  name         String
  sportId      Int
  districtId   Int
  upazilaId    Int
  unionId      Int?
  captainId    String
  logoUrl      String?
  logoPublicId String?
  // Shared by the captain; entering it joins the team (so nobody can be added without consent).
  joinCode     String   @unique @default(dbgenerated("upper(substr(md5(((random())::text || (clock_timestamp())::text)), 1, 8))"))
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sport    Sport           @relation(fields: [sportId], references: [id])
  district District        @relation(fields: [districtId], references: [id])
  upazila  Upazila         @relation(fields: [upazilaId], references: [id])
  union    Union?          @relation(fields: [unionId], references: [id])
  captain  User            @relation("TeamCaptain", fields: [captainId], references: [id])
  members  TeamMember[]
  requests PlayerRequest[]

  @@index([captainId])
  @@index([sportId, upazilaId])
}

model TeamMember {
  id       String         @id @default(cuid())
  teamId   String
  userId   String
  role     TeamMemberRole @default(PLAYER)
  joinedAt DateTime       @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// "Player needed" requests & applications
// ─────────────────────────────────────────────────────────────────────────────

model PlayerRequest {
  id              String        @id @default(cuid())
  createdById     String
  teamId          String?
  sportId         Int
  matchAt         DateTime
  venueText       String
  districtId      Int
  upazilaId       Int
  unionId         Int?
  positionsNeeded String[] // Position.code values
  playersNeeded   Int           @default(1)
  playersAccepted Int           @default(0) // maintained transactionally when applications are accepted
  budgetMin       Int?
  budgetMax       Int?
  isPaid          Boolean       @default(false)
  notes           String?
  kind            RequestKind   @default(MATCH)
  joinMode        JoinMode      @default(APPROVAL)
  title           String? // events only: "Under-17 trial, Barishal"
  status          RequestStatus @default(OPEN)
  isHidden        Boolean       @default(false) // admin moderation
  completedAt     DateTime? // starts the 7-day rating window
  boostedUntil    DateTime? // reserved for paid boost; unused for now

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy    User          @relation(fields: [createdById], references: [id])
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sport        Sport         @relation(fields: [sportId], references: [id])
  district     District      @relation(fields: [districtId], references: [id])
  upazila      Upazila       @relation(fields: [upazilaId], references: [id])
  union        Union?        @relation(fields: [unionId], references: [id])
  applications Application[]
  ratings      Rating[]
  invites      Invite[]
  chatMessages GameMessage[]
  groundFee       Int? // total ground rent in BDT, split between the players
  feePayTo        String? // where players send their share, e.g. "bKash 01XXXXXXXXX"; shown to accepted players only
  seriesId     String?
  series       GameSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@index([status, matchAt])
  @@index([upazilaId, status, matchAt])
  @@index([districtId, status, matchAt])
  @@index([sportId, status, matchAt])
  @@index([createdById, createdAt(sort: Desc)])
  @@index([status, completedAt]) // rating-reminder job and rating windows
  @@index([positionsNeeded], type: Gin)
  result MatchResult?
}

/// A weekly game ("Friday football"): the same ground, day and time every week. A job posts the next game once the
/// last one has started; regulars are told when it is up.
model GameSeries {
  id              String   @id @default(cuid())
  createdById     String
  title           String
  sportId         Int
  districtId      Int
  upazilaId       Int
  unionId         Int?
  venueText       String
  weekday         Int // 0 = Sunday … 6 = Saturday, Asia/Dhaka
  startTime       String // "HH:MM", Asia/Dhaka
  positionsNeeded String[]
  playersNeeded   Int      @default(1)
  isPaid          Boolean  @default(false)
  budgetMin       Int?
  budgetMax       Int?
  notes           String?
  joinMode        JoinMode @default(APPROVAL)
  teamId          String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  sport     Sport           @relation(fields: [sportId], references: [id])
  district  District        @relation(fields: [districtId], references: [id])
  upazila   Upazila         @relation(fields: [upazilaId], references: [id])
  union     Union?          @relation(fields: [unionId], references: [id])
  members   SeriesMember[]
  games     PlayerRequest[]

  @@index([createdById])
  @@index([isActive])
}

model SeriesMember {
  id       String   @id @default(cuid())
  seriesId String
  userId   String
  joinedAt DateTime @default(now())

  series GameSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seriesId, userId])
  @@index([userId])
}

/// The score of a played match, entered by its organiser: our side first.
model MatchResult {
  id             String   @id @default(cuid())
  requestId      String   @unique
  recordedById   String
  ourScore       Int
  theirScore     Int
  opponentName   String?
  summary        String? // free text for sports where a number is not enough: "won by 3 wickets"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  request PlayerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Application {
  id                 String            @id @default(cuid())
  requestId          String
  playerId           String // User.id of the applicant
  proposedRate       Int?
  message            String?
  status             ApplicationStatus @default(PENDING)
  respondedAt        DateTime?
  waitlistedAt       DateTime? // when the player joined the waitlist: the queue order
  feePaidAt          DateTime? // the organiser ticked this player's ground-fee share as received
  // Marked by the organiser after the game; drives the player's reliability score.
  attendance         Attendance?
  attendanceMarkedAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  request PlayerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  player  User          @relation(fields: [playerId], references: [id])

  @@unique([requestId, playerId])
  @@index([requestId, status, waitlistedAt])
  @@index([playerId, attendance])
  @@index([playerId, status])
  @@index([requestId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Ratings
// ─────────────────────────────────────────────────────────────────────────────

/// One group chat per game. Membership is derived (organiser + ACCEPTED applicants), so there is no
/// member table to drift; the chat turns read-only 7 days after the game.
model GameMessage {
  id        String   @id @default(cuid())
  requestId String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  request PlayerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User          @relation("GameMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt(sort: Desc)])
}

model Rating {
  id              String          @id @default(cuid())
  requestId       String
  raterId         String
  rateeId         String
  direction       RatingDirection
  // CAPTAIN_TO_PLAYER: { skill, punctuality, behavior }   PLAYER_TO_CAPTAIN: { payment, behavior, organization }
  // each 1–5. Shape enforced by Zod per direction.
  scores          Json
  overall         Float // mean of `scores`, stored so aggregates are a cheap AVG()
  comment         String?
  noShow          Boolean         @default(false) // only valid for CAPTAIN_TO_PLAYER; mirrors Application.attendance = NO_SHOW
  createdAt       DateTime        @default(now())
  // Double-blind: a review stays hidden from its subject (and every aggregate) until both sides have rated or the
  // window has closed. No-show strikes are revealed immediately (they carry no review text).
  revealedAt      DateTime?
  replyText       String?
  repliedAt       DateTime?
  // Set by an admin (moderation or an upheld dispute); hidden rows are excluded from every aggregate and list.
  hiddenByAdminAt DateTime?

  request PlayerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  rater   User          @relation("RatingRater", fields: [raterId], references: [id])
  ratee   User          @relation("RatingRatee", fields: [rateeId], references: [id])

  disputes RatingDispute[]

  @@unique([requestId, raterId, rateeId])
  @@index([rateeId, direction])
  @@index([revealedAt])
}

enum RatingDisputeStatus {
  OPEN
  UPHELD // the admin kept the review/strike
  REMOVED // the admin removed it
}

model RatingDispute {
  id            String              @id @default(cuid())
  ratingId      String
  disputerId    String
  reason        String
  photoPublicId String?
  status        RatingDisputeStatus @default(OPEN)
  adminNote     String?
  resolvedById  String?
  createdAt     DateTime            @default(now())
  resolvedAt    DateTime?

  rating Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)

  @@unique([ratingId])
  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  token      String         @unique // FCM registration token
  platform   DevicePlatform
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  data      Json // deep-link payload, e.g. { requestId, applicationId }
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([createdAt]) // retention purge
}

/// A recruiter opening a player's profile: one row per recruiter per player per Dhaka day.
model ProfileView {
  id        String   @id @default(cuid())
  profileId String
  viewerId  String
  day       DateTime @db.Date // Asia/Dhaka calendar day
  createdAt DateTime @default(now())

  profile PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  viewer  User          @relation("ProfileViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  sport   Sport?        @relation(fields: [sportId], references: [id])
  sportId Int?

  @@unique([profileId, viewerId, day])
  @@index([profileId, createdAt(sort: Desc)])
}

/// Facts about every uploaded image, keyed by its storage path: so layouts can reserve the space before it loads.
model MediaAsset {
  path      String   @id // the media service path (= publicId everywhere else)
  mediaId   String? // the media service's own id
  mime      String
  width     Int?
  height    Int?
  size      Int?
  createdAt DateTime @default(now())

  @@index([mediaId])
}

/// A verification document. Stored AES-256-GCM encrypted (as base64 text, the only shape the media service accepts
/// besides images) in `verification/<userId>/`: the service has no private mode, so what sits at its public URL is
/// unreadable. Only our API, with the key, can turn it back into the picture. No public URL is ever built for it.
model VerificationFile {
  id        String   @id @default(cuid())
  userId    String
  requestId String? // null until it is attached to a submitted request
  path      String   @unique // media service path of the encrypted blob
  mediaId   String?
  mime      String // of the original image
  width     Int?
  height    Int?
  size      Int // of the original image, bytes
  createdAt DateTime @default(now())

  user    User                 @relation("VerificationFileOwner", fields: [userId], references: [id], onDelete: Cascade)
  request VerificationRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([userId, createdAt])
}

/// What the user wants to hear about. No row = the defaults below.
model NotificationPreference {
  userId            String   @id
  games             Boolean  @default(true) // matches near me, applications, reminders, filled/cancelled, rating reminders
  messages          Boolean  @default(true) // chats and game chats
  recruitment       Boolean  @default(true) // invites, number viewed
  system            Boolean  @default(true) // payments, verification, announcements
  nearbyAvailable   Boolean  @default(true) // "someone near you is free today"
  profileViewed     Boolean  @default(true) // "a recruiter viewed your profile"
  quietHoursEnabled Boolean  @default(true)
  quietStart        String   @default("23:00") // Asia/Dhaka, HH:MM
  quietEnd          String   @default("07:00")
  chatInQuietHours  Boolean  @default(false) // let chat messages through during quiet hours
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A browser's standard Web Push (VAPID) subscription. Removed when the push service answers 404/410.
model WebPushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// The push queue AND the send log: a row per (notification × user). Request handlers only enqueue; a worker
/// sends, retries with backoff, and the dashboard reads this table to show what happened.
model PushJob {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType
  payload        Json // strings only: deep-link ids + display params (what the inbox row holds too)
  status         PushStatus       @default(PENDING)
  attempts       Int              @default(0)
  nextAttemptAt  DateTime         @default(now())
  expiresAt      DateTime? // a game reminder that would arrive after the game is dropped
  collapseKey    String? // a still-pending job with the same key absorbs newer ones (chat bursts)
  announcementId String?
  deviceCount    Int              @default(0)
  deliveredCount Int              @default(0)
  skipReason     String?
  lastError      String?
  createdAt      DateTime         @default(now())
  sentAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([announcementId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
}

/// A message from the dashboard to a slice of users, kept so delivery can be reviewed afterwards.
model Announcement {
  id          String   @id @default(cuid())
  createdById String
  title       String
  body        String
  audience    Json // { role, sportId, divisionId, districtId }
  recipients  Int
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// Moderation & config
// ─────────────────────────────────────────────────────────────────────────────

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  reason       String
  details      String?
  status       ReportStatus     @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime         @default(now())

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id])
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model AppConfig {
  key       String   @id // ads_enabled, boost_enabled, min_app_version, …
  value     Json
  updatedAt DateTime @updatedAt
}

/// Append-only trail of moderator actions: who did what to whom, and why.
model AdminAction {
  id         String          @id @default(cuid())
  adminId    String
  action     AdminActionType
  targetType String // USER | PLAYER_PROFILE | REQUEST | REPORT | CONFIG
  targetId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime        @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([adminId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Contact, invites, shortlist, events
// ─────────────────────────────────────────────────────────────────────────────

/// Someone tapped "show number" on a player's profile. One row per (viewer, player): re-opening is free, and the
/// player can see who looked.
model ContactReveal {
  id        String   @id @default(cuid())
  viewerId  String
  profileId String
  cost      Int      @default(0) // credits spent (0 = within the free daily allowance, or already related)
  createdAt DateTime @default(now())

  viewer  User          @relation("ContactViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  profile PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([viewerId, profileId])
  @@index([profileId, createdAt(sort: Desc)])
  @@index([viewerId, createdAt(sort: Desc)])
}

/// A recruiter asking one player to come (optionally to a specific event). Accepting shares both numbers.
model Invite {
  id          String       @id @default(cuid())
  recruiterId String
  profileId   String
  sportId     Int?
  requestId   String?
  message     String?
  status      InviteStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  recruiter User           @relation("InviteRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  profile   PlayerProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  request   PlayerRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  // A partial unique index (one PENDING invite per recruiter + player) lives in the migration.
  @@index([profileId, status, createdAt(sort: Desc)])
  @@index([recruiterId, createdAt(sort: Desc)])
}

model ShortlistEntry {
  id          String   @id @default(cuid())
  recruiterId String
  profileId   String
  note        String?
  createdAt   DateTime @default(now())

  recruiter User          @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, profileId])
  @@index([recruiterId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// Verification (recruiters, and the stats on a player's sport profile)
// ─────────────────────────────────────────────────────────────────────────────

model VerificationRequest {
  id                 String             @id @default(cuid())
  kind               VerificationKind
  submitterId        String
  recruiterProfileId String?
  playerSportId      String?
  note               String?
  evidenceLinks      String[] // https links: a page, a federation record, a match report
  evidenceImages     Json? // LEGACY public images; `scripts/migrate-evidence-private.ts` moves them into `files` and clears this
  files              VerificationFile[]
  status             VerificationStatus @default(PENDING)
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNote         String?
  createdAt          DateTime           @default(now())

  submitter        User              @relation("VerificationSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  reviewedBy       User?             @relation("VerificationReviewer", fields: [reviewedById], references: [id])
  recruiterProfile RecruiterProfile? @relation(fields: [recruiterProfileId], references: [id], onDelete: Cascade)
  playerSport      PlayerSport?      @relation(fields: [playerSportId], references: [id], onDelete: Cascade)

  // Partial unique indexes (one PENDING request per target) live in the migration.
  @@index([status, createdAt])
  @@index([submitterId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// Credits & payments
// ─────────────────────────────────────────────────────────────────────────────

model CreditPack {
  id       String  @id @default(cuid())
  code     String  @unique
  credits  Int
  priceBdt Int
  isActive Boolean @default(true)
  order    Int     @default(0)

  payments Payment[]
}

/// Append-only. `User.creditBalance` is always the sum of a user's rows; both change in one transaction.
model CreditTransaction {
  id           String       @id @default(cuid())
  userId       String
  delta        Int
  balanceAfter Int
  reason       CreditReason
  refType      String?
  refId        String?
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Payment {
  id           String        @id @default(cuid())
  userId       String
  packId       String
  credits      Int // copied from the pack at checkout so later price edits never change an order
  amountBdt    Int
  method       PaymentMethod
  trxId        String? // the bKash / Nagad / Rocket transaction id the user paid with
  senderNumber String?
  status       PaymentStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack CreditPack @relation(fields: [packId], references: [id])

  @@unique([method, trxId]) // a transaction id can only ever buy credits once
  @@index([status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat (recruiter ⇄ player, one conversation per pair)
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id                 String    @id @default(cuid())
  recruiterId        String
  playerId           String
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String?
  recruiterUnread    Int       @default(0)
  playerUnread       Int       @default(0)
  // Set by the player to stop the recruiter writing; the recruiter isn't told why.
  blockedAt          DateTime?
  createdAt          DateTime  @default(now())

  recruiter User      @relation("ConversationRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  player    User      @relation("ConversationPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([recruiterId, playerId])
  @@index([recruiterId, lastMessageAt(sort: Desc)])
  @@index([playerId, lastMessageAt(sort: Desc)])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// First-party crash and usage telemetry (no third-party SDK, no IP address, no account id)
// ─────────────────────────────────────────────────────────────────────────────

enum TelemetryKind {
  ERROR
  EVENT
}

/// One crash/error or one funnel step sent by the web or the app. `sessionId` is random per tab/install and is
/// never linked to an account. Rows are deleted after 90 days (see the purge job).
model TelemetryEvent {
  id          String        @id @default(cuid())
  at          DateTime      @default(now())
  kind        TelemetryKind
  name        String // event name ("signup_completed") or error source ("window.onerror", "react", "api_5xx", "flutter")
  platform    String // WEB | ANDROID | IOS
  appVersion  String?
  sessionId   String
  route       String? // path or screen name, no query string
  message     String?
  stack       String?
  fingerprint String? // groups the same error together
  props       Json? // small, string/number/boolean values only
  locale      String?

  @@index([kind, at])
  @@index([kind, name, at])
  @@index([fingerprint, at])
}
